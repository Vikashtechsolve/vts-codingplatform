{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker"
  },
  "deploy": {
    "startCommand": "node /srv/backend/workers/codeExecutionWorker.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 15
  }
}
