{
  "name": "coding-platform-backend",
  "version": "1.0.0",
  "description": "Backend for coding platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "start:pm2:prod": "pm2 start ecosystem.config.js --env production",
    "stop:pm2": "pm2 stop ecosystem.config.js",
    "restart:pm2": "pm2 restart ecosystem.config.js",
    "delete:pm2": "pm2 delete ecosystem.config.js",
    "logs:pm2": "pm2 logs",
    "monit:pm2": "pm2 monit",
    "worker": "node workers/evaluationWorker.js",
    "worker:code": "node workers/codeExecutionWorker.js",
    "dev": "nodemon server.js",
    "dev:worker": "nodemon workers/evaluationWorker.js",
    "dev:code-worker": "nodemon workers/codeExecutionWorker.js",
    "peek:code-queue": "node scripts/peek-code-queue.js",
    "watch": "nodemon --watch . --ext js --exec node server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.21.0",
    "pm2": "^5.4.3",
    "redis": "^5.10.0",
    "resend": "^6.12.3",
    "simple-git": "^3.30.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
