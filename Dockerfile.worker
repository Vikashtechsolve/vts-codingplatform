# Same as backend/Dockerfile.worker — use when Ownkube points at ./Dockerfile.worker
# Build context must be the monorepo root.

FROM node:20-slim

# Compilers for code execution + make/python3 for native module builds (better-sqlite3)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    default-jdk-headless \
    gcc \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /srv/backend

COPY backend/package*.json ./
RUN npm install --omit=dev && npm cache clean --force

COPY backend/ .

RUN mkdir -p temp logs && chmod 755 temp logs \
  && test -f /srv/backend/workers/codeExecutionWorker.js \
  && python3 --version \
  && javac -version \
  && gcc --version \
  && g++ --version

# No HEALTHCHECK — this is a queue worker with no HTTP server

CMD ["node", "/srv/backend/workers/codeExecutionWorker.js"]
